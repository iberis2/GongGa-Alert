# Local dashboard URL included in Kakao messages.
DASHBOARD_URL=http://localhost:3000

# Kakao message mode: disabled, me, or friend.
# Use disabled until Kakao access tokens and permissions are ready.
KAKAO_SEND_MODE=disabled
KAKAO_REST_API_KEY=
KAKAO_ACCESS_TOKEN=
KAKAO_REFRESH_TOKEN=
KAKAO_CLIENT_SECRET=

# Required for KAKAO_SEND_MODE=friend. Comma-separated Kakao friend UUIDs.
KAKAO_FRIEND_UUIDS=
